{
  "model_name": "Decision Tree (Balanced)",
  "target": "Arrest",
  "feature_cols": [
    "UNIFIED_LOCATION_CODE",
    "month",
    "day",
    "hour",
    "weekday",
    "is_weekend",
    "is_holiday",
    "crime_against",
    "offense_category_name"
  ],
  "categorical_features": [
